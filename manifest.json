{
  "manifest_version": 3,
  "name": "Pomodoro Tab",
  "version": "1.2.0",
  "description": "A minimal Pomodoro timer extension.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pomodoro Tab"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ]
}